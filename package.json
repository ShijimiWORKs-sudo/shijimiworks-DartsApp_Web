{
  "name": "darts-app",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "start:tunnel": "expo start --tunnel --port 8099 --clear",
    "start:lan": "expo start --lan --port 8099 --clear",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "node scripts/start-web-with-headers.cjs",
    "web:lan-main": "node scripts/start-web-with-headers.cjs --port 8112 --clear",
    "camera:node": "node scripts/start-web-with-headers.cjs --port 8110 --clear",
    "camera:relay": "node scripts/start-lan-camera-relay.cjs --host 0.0.0.0 --port 8120",
    "eas:build:preview": "eas build --platform ios --profile preview",
    "eas:build:production": "eas build --platform ios --profile production",
    "eas:submit:ios": "eas submit --platform ios",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/run-tests.cjs",
    "test:watch": "node --watch scripts/run-tests.cjs",
    "validate:data": "node scripts/validate-data.cjs",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.0",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-router": "~6.0.24",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-native": "^0.81.5",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.0",
    "@types/react": "~19.1.10",
    "eslint": "^9.39.4",
    "eslint-config-expo": "~10.0.0",
    "prettier": "^3.9.4",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
